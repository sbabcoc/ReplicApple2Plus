<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <!-- This view exists only to hold keyboard/focus for onGenericMotionEvent
         and onKeyDown/onKeyUp to reach the Activity; it is never shown as
         an editable field to the user. -->
    <TextView
        android:id="@+id/controllerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:text="Looking for a controller..." />

    <EditText
        android:id="@+id/targetHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Target IP (default: 127.0.0.1)"
        android:inputType="text" />

    <EditText
        android:id="@+id/targetPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Target port (default: 8942)"
        android:inputType="number" />

    <Button
        android:id="@+id/applyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Apply" />

    <TextView
        android:id="@+id/packetsSent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Packets sent: 0" />
</LinearLayout>
